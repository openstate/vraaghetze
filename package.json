{
	"name": "vraaghetze",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.3.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:start": "docker compose -f docker-compose.dev.yml up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --output src/lib/server/db/auth.schema.ts --yes && sed -i '1i // Do not edit this file. It was automatically generated by `pnpm run auth:schema`.\\n' src/lib/server/db/auth.schema.ts"
	},
	"devDependencies": {
		"@better-auth/cli": "~1.4.21",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.2.9",
		"@fontsource-variable/geist-mono": "^5.2.8",
		"@fontsource-variable/manuale": "^5.2.8",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify/tailwind4": "^1.2.3",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22.19.19",
		"better-auth": "~1.4.22",
		"bits-ui": "^2.18.1",
		"dotenv": "^17.4.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.56.0",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0",
		"vite": "^8.0.14",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"croner": "^10.0.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"email-reply-parser": "^2.3.5",
		"sharp": "^0.34.5"
	}
}
