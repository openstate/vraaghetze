# Postgres
POSTGRES_USER="root"
POSTGRES_PASSWORD=""
POSTGRES_DB="local"

# Drizzle (must match POSTGRES_* values above)
# For local dev: postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
# For docker-compose.yml: postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_URL=""

# Public base URL of the site without a trailing slash (e.g. https://vraaghetze.nu)
# See https://svelte.dev/docs/kit/adapter-node#Environment-variables
ORIGIN=""

# Basic Auth (optional). Gate the entire site behind HTTP basic auth.
# Leave both empty to disable. Set both to enable (e.g. for staging).
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""

# Better Auth
# Use `openssl rand -base64 32` to generate.
# See https://better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# SendGrid
# EMAIL_DOMAIN is the sending domain: mail goes out as noreply@ and replies come back on antwoord+<token>@
# EMAIL_INBOX is the reply-to address for mail without its own reply token.
SENDGRID_API_KEY=""
EMAIL_DOMAIN=""
EMAIL_INBOX=""

# Shared secret for the SendGrid Inbound Parse webhook (?token=... on /api/sendgrid/inbound)
# Use `openssl rand -base64 32` to generate.
# And set in SendGrid Inbound Parse settings for the domain.
INBOUND_MAIL_TOKEN=""

# Pre-launch e-mail safety (optional). When set, all politician-facing mail is diverted to
# this address, and replies from it are accepted as if from the assigned politician.
# Leave empty in production after launch.
DIVERSION_EMAIL=""

# SvelteKit's Node adapter has a default request body size limit of 512K.
# Inbound mails can exceed that. SendGrid would repeadetly retry and then drop the mail.
BODY_SIZE_LIMIT=""
